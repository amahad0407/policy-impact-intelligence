# ── Regulations.gov ──────────────────────────────────────────────────────────
# Free key: https://api.data.gov/signup/
REGULATIONS_API_KEY=your_key_here

# ── Azure OpenAI via AI Foundry ───────────────────────────────────────────────
# From Azure portal → AI Foundry hub → your project → Deployments
# Endpoint format: https://<resource-name>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=your_key_here
# The deployment name you chose when deploying GPT-4o in Foundry
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
# Latest stable API version — check https://learn.microsoft.com/azure/ai-services/openai/reference
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ── Azure AI Search (Phase 4 — not needed yet) ───────────────────────────────
AZURE_SEARCH_ENDPOINT=https://YOUR_SEARCH.search.windows.net
AZURE_SEARCH_API_KEY=your_key_here
AZURE_SEARCH_INDEX_NAME=policy-documents

# ── Bing News Search (Phase 4 — not needed yet) ──────────────────────────────
BING_NEWS_API_KEY=your_key_here

# ── Production deployment ─────────────────────────────────────────────────────
# Set FRONTEND_ORIGIN on the backend to your Vercel URL (no trailing slash).
# This is the ONLY variable required at runtime to serve the pre-generated JSON.
FRONTEND_ORIGIN=https://your-app.vercel.app

# ── Frontend ──────────────────────────────────────────────────────────────────
# Set NEXT_PUBLIC_API_URL in Vercel's project environment variables to your deployed backend URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
